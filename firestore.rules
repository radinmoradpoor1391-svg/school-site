rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role-based helper from user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.role == 'teacher' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'teacher')
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Students collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 3. Teachers collection
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 4. Classes collection
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 5. Subjects collection
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 6. Grades collection
    match /grades/{gradeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 7. Attendance collection
    match /attendance/{recordId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 8. Homeworks collection
    match /homeworks/{homeworkId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 9. Homework Submissions collection
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 10. Announcements collection
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 11. Report cards collection
    match /reportCards/{reportId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 12. Teacher notes collection
    match /teacherNotes/{noteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 13. Audit logs collection
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 14. Academic years collection
    match /academicYears/{yearId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 15. School configuration
    match /schoolConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
  }
}
